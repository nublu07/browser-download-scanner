# Файл настроек Browser Download Scanner
# Изменения применяются автоматически (перечитываются каждые 5 сек)

[general]
enabled = true
run_at_startup = true
watch_folder = %USERPROFILE%\Downloads
max_file_size_mb = 1024
scan_existing_on_startup = true

[virustotal]
# API-ключ: https://www.virustotal.com/gui/my-apikey
api_key =
detection_threshold = 1

[performance]
debounce_seconds = 1.5
api_rate_limit_seconds = 15
scan_workers = 1

[logging]
debug = false
